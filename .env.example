# RISK//MESH environment configuration.
# Nothing in this repo reads secrets from source. Copy this file to .env and fill in real values
# locally; .env is gitignored.

# risk-replay backend, once a live adapter is built (Phase 7). Leave unset to keep the adapter
# status NOT_CONNECTED rather than pointing it at a guessed URL.
RISK_REPLAY_API_BASE_URL=

# Laya / Jev. laya-typed is now a real, live connection (2026-09-23) and needs no token at all -
# its HuggingFace checkpoint is public. LAYA_HF_TOKEN only matters for a private/gated checkpoint,
# which none of the three current Laya checkpoints are. Jev is confirmed real (TypeSafe AI) but
# invite-only; leave JEV_API_KEY unset until an invite exists - an unset key must mean
# UNAVAILABLE, never a fabricated response.
LAYA_HF_TOKEN=
JEV_API_KEY=
